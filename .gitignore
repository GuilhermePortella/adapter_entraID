# Java: arquivos compilados e falhas da JVM
*.class
hs_err_pid*
replay_pid*
*.hprof

# Maven (preserva .mvn/ e os wrappers)
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
.mvn/timing.properties

# Gradle (preserva gradle/wrapper/ e os scripts gradlew)
.gradle/
.kotlin/
build/
gradle-app.setting

# Ant / NetBeans
dist/
nbbuild/
nbdist/
.nb-gradle/
nbproject/private/

# Saídas de compilação e ferramentas de análise
out/
bin/
.apt_generated/
.apt_generated_tests/
.factorypath
.checkstyle
.pmd
.scannerwork/
.sonarlint/
.sonar/
coverage/
*.exec

# Logs e arquivos temporários
logs/
*.log
*.log.*
*.tmp
*.temp
*.bak
*.swp
*.swo
*~

# Spring Boot: configurações locais (não guardar credenciais)
**/application-local.properties
**/application-local.yml
**/application-local.yaml
**/application-secrets.properties
**/application-secrets.yml
**/application-secrets.yaml
spring-boot-devtools.properties
.spring-boot-devtools.properties
.spring-boot-devtools.yml
.spring-boot-devtools.yaml

# Variáveis de ambiente (preserva modelos)
.env
.env.*
!.env.example
!.env.sample
!.env.template
.envrc

# Chaves privadas e keystores locais
*.key
*.p12
*.pfx
*.jks
*.keystore

