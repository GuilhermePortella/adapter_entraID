*.mv.db
*.trace.db
*.h2.db
*.sqlite
*.sqlite3
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm

# IntelliJ IDEA
.idea/
*.iml
*.ipr
*.iws

# Eclipse / Spring Tool Suite
.classpath
.project
.settings/
.metadata/
.recommenders/
.sts4-cache/

# Visual Studio Code: preserva configurações compartilháveis
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets
.history/

