# Directory (tenant) ID — single tenant, nuvem pública Microsoft
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
# Application (client) ID do registro da API, não do cliente/frontend
ENTRA_AUDIENCE=11111111-1111-1111-1111-111111111111
PORT=8080

# Habilita o login BFF além da API Bearer.
ENTRA_LOGIN_ENABLED=true
ENTRA_CLIENT_ID=22222222-2222-2222-2222-222222222222
# Preencha somente no ambiente local/secret manager; nunca faça commit do valor.
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=http://localhost:8080/login/oauth2/code/entra
# Somente para HTTP localhost. Em HTTPS/HOMOL use true (padrão).
SESSION_COOKIE_SECURE=false
